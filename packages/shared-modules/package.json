{
  "name": "@repo/shared-modules",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./optimizer": {
      "import": {
        "types": "./dist/optimizer.d.mts",
        "default": "./dist/optimizer.mjs"
      },
      "require": {
        "types": "./dist/optimizer.d.ts",
        "default": "./dist/optimizer.cjs"
      }
    }
  },
  "scripts": {
    "build": "pkgroll",
    "dev": "pkgroll --watch"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "pkgroll": "2.5.1",
    "typescript": "^5.9.3"
  }
}
