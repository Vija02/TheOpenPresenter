<mjml>
  <mj-head>
    <mj-include path="./common/head.mjml" />
  </mj-head>
  <mj-body background-color="#FDFDFD">
    <mj-include path="./common/header.mjml" />

    <mj-section background-color="#ffffff" padding-top="20px">
      <mj-column width="100%">
        <mj-text
          align="center"
          color="#444"
          font-size="28px"
          font-family="Lato, Helvetica, Arial, sans-serif"
          padding="10px 30px"
          ><strong>New sponsorship application</strong></mj-text
        >
        <mj-text
          color="#444"
          font-size="16px"
          line-height="24px"
          font-family="Inter,Lato, Helvetica, Arial, sans-serif"
          padding="10px 30px"
        >
          <strong>Organization:</strong> [[organizationName]] ([[organizationSlug]])<br />
          <strong>Applicant:</strong> [[applicantName]] &lt;[[applicantEmail]]&gt;<br />
          <strong>Weekly attendance:</strong> [[weeklyAttendance]]
        </mj-text>
        <mj-text
          color="#444"
          font-size="16px"
          line-height="24px"
          font-family="Inter,Lato, Helvetica, Arial, sans-serif"
          padding="10px 30px"
        >
          <strong>About the church</strong><br />
          <span style="white-space: pre-wrap">[[aboutChurch]]</span>
        </mj-text>
        <mj-text
          color="#444"
          font-size="16px"
          line-height="24px"
          font-family="Inter,Lato, Helvetica, Arial, sans-serif"
          padding="10px 30px"
        >
          <strong>How they'll use it</strong><br />
          <span style="white-space: pre-wrap">[[intendedUse]]</span>
        </mj-text>
        <mj-text
          color="#666"
          font-size="14px"
          line-height="22px"
          font-family="Menlo, Consolas, monospace"
          padding="20px 30px"
        >
          select * from app_private.approve_sponsorship_application('[[applicationId]]', '12 months', 'note');<br /><br />
          select * from app_private.decline_sponsorship_application('[[applicationId]]', 'reason');<br /><br />
          -- Spam? Decline without emailing them:<br />
          select * from app_private.decline_sponsorship_application('[[applicationId]]', 'spam', false);
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./common/footer_transactional.mjml" />
  </mj-body>
</mjml>
