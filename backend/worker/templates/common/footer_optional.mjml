<mjml>
  <mj-body>
    <mj-section background-color="#ffffff" padding="10px">
      <mj-column vertical-align="top" width="100%">
        <mj-text
          align="center"
          color="gray"
          font-size="12px"
          font-family="Inter, Lato, Helvetica, Arial, sans-serif"
          padding="10px 25px 0"
          >Best, [[projectName]] Team</mj-text
        >
        <mj-text
          align="center"
          color="gray"
          font-size="12px"
          font-family="Inter, Lato, Helvetica, Arial, sans-serif"
          padding="10px 25px"
          >You're getting this because you signed up for [[projectName]].<br />
          <a href="[[unsubscribeLink]]" style="color: gray">Unsubscribe</a>
          &middot;
          <a href="[[emailSettingsLink]]" style="color: gray"
            >Email settings</a
          ></mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
