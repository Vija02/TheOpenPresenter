{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "description": "TheOpenPresenter studio app",
  "homepage": "https://theopenpresenter.com",
  "author": {
    "name": "TheOpenPresenter",
    "email": "hello@theopenpresenter.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vija02/TheOpenPresenter.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run prepare:sidecar && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run prepare:sidecar && vitest run",
    "pack": "npm run prepare:sidecar && npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "prepare:sidecar": "node scripts/prepare-sidecar.cjs"
  },
  "dependencies": {
    "@repo/ui": "file:../../packages/ui",
    "electron-updater": "^6.8.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^43.7.7",
    "electron-builder": "^26.17.0",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.8"
  }
}
