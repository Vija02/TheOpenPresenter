---
import Logo from "./Logo.astro";
---

<footer class="relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div
      class="py-12 md:py-16 border-t border-gray-200 dark:border-gray-800 -mt-px"
    >
      <!-- Footer illustration -->
      <div class="pointer-events-none -z-1" aria-hidden="true">
        <svg
          class="absolute bottom-0 left-0 transform -translate-x-1/2 ml-24 dark:opacity-40"
          width="800"
          height="264"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="400"
            cy="400"
            r="400"
            fill="url(#footerglow_paint0_radial)"
            fill-opacity=".4"></circle>
          <defs>
            <radialGradient
              id="footerglow_paint0_radial"
              cx="0"
              cy="0"
              r="1"
              gradientUnits="userSpaceOnUse"
              gradientTransform="rotate(90 0 400) scale(315.089)"
            >
              <stop stop-color="#3ABAB4"></stop>
              <stop offset="1" stop-color="#3ABAB4" stop-opacity=".01"></stop>
            </radialGradient>
          </defs>
        </svg>
      </div>

      <!-- Top area: Blocks -->
      <div class="grid md:grid-cols-12 gap-8 lg:gap-20 mb-8 md:mb-12">
        <!-- 1st block -->
        <div class="md:col-span-2 lg:col-span-3">
          <!-- Logo -->
          <a class="inline-block" href="/" aria-label="TheOpenPresenter Logo">
            <Logo />
          </a>
        </div>

        <!-- 2nd, 3rd, 4th and 5th blocks -->
        <div
          class="md:col-span-10 lg:col-span-9 grid grid-cols-2 md:grid-cols-4 gap-8"
        >
          <!-- 2nd block -->
          <div class="text-sm">
            <h6 class="font-medium uppercase mb-2">Screens</h6>
            <ul>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="/setup"
                >
                  Setup this screen
                </a>
              </li>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="/connect"
                >
                  Connect to a screen
                </a>
              </li>
            </ul>
          </div>

          <!-- Resources -->
          <div class="text-sm">
            <h6 class="font-medium uppercase mb-2">Resources</h6>
            <ul>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="/pricing"
                >
                  Pricing
                </a>
              </li>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="/download"
                >
                  Downloads
                </a>
              </li>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="/how-to"
                >
                  How-to guides
                </a>
              </li>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="/compare"
                >
                  Comparisons
                </a>
              </li>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="/blog"
                >
                  Blog
                </a>
              </li>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="mailto:support@theopenpresenter.com"
                >
                  Email
                </a>
              </li>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="/support"
                >
                  Support
                </a>
              </li>
            </ul>
          </div>

          <!-- Solutions -->
          <div class="text-sm">
            <h6 class="font-medium uppercase mb-2">Solutions</h6>
            <ul>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="/church"
                >
                  For churches
                </a>
              </li>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="/meeting-room"
                >
                  For meeting rooms
                </a>
              </li>
            </ul>
          </div>

          <!-- Sponsorship -->
          <div class="text-sm">
            <h6 class="font-medium uppercase mb-2">Sponsorship</h6>
            <ul>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="/church/sponsorship"
                >
                  Small church sponsorship
                </a>
              </li>
              <li class="mb-1">
                <a
                  class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                  href="/church/donate"
                >
                  Donate
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Bottom area -->
      <div class="md:flex md:items-center md:justify-between">
        <!-- Social links -->
        <ul class="flex mb-4 md:order-2 md:ml-4 md:mb-0">
          <li>
            <a
              class="flex justify-center items-center text-white bg-teal-500 dark:text-teal-500 dark:bg-gray-800 hover:underline hover:bg-teal-600 rounded-full transition duration-150 ease-in-out"
              href="https://github.com/Vija02/TheOpenPresenter"
              aria-label="Github"
            >
              <svg
                class="w-8 h-8 fill-current"
                viewBox="0 0 32 32"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M16 8.2c-4.4 0-8 3.6-8 8 0 3.5 2.3 6.5 5.5 7.6.4.1.5-.2.5-.4V22c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.3 1.9.9 2.3.7.1-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8.6-.2 1.3-.3 2-.3s1.4.1 2 .3c1.5-1 2.2-.8 2.2-.8.4 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.1 0 3.1-1.9 3.7-3.7 3.9.3.4.6.9.6 1.6v2.2c0 .2.1.5.6.4 3.2-1.1 5.5-4.1 5.5-7.6-.1-4.4-3.7-8-8.1-8z"
                ></path>
              </svg>
            </a>
          </li>
          <li class="ml-4">
            <a
              class="flex justify-center items-center text-white bg-teal-500 dark:text-teal-500 dark:bg-gray-800 hover:underline hover:bg-teal-600 rounded-full transition duration-150 ease-in-out"
              href="https://www.linkedin.com/company/theopenpresenter"
              aria-label="LinkedIn"
            >
              <svg
                class="w-8 h-8 fill-current"
                viewBox="0 0 32 32"
                xmlns="http://www.w3.org/2000/svg"
              >
                <g transform="translate(8 8) scale(0.6667)">
                  <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                  ></path>
                </g>
              </svg>
            </a>
          </li>
          <li class="ml-4">
            <a
              class="flex justify-center items-center text-white bg-teal-500 dark:text-teal-500 dark:bg-gray-800 hover:underline hover:bg-teal-600 rounded-full transition duration-150 ease-in-out"
              href="https://www.instagram.com/theopenpresenter/"
              aria-label="Instagram"
            >
              <svg
                class="w-8 h-8 fill-current"
                viewBox="0 0 32 32"
                xmlns="http://www.w3.org/2000/svg"
              >
                <g transform="translate(8 8) scale(0.6667)">
                  <path
                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
                  ></path>
                </g>
              </svg>
            </a>
          </li>
        </ul>

        <!-- Middle links -->
        <div class="text-sm md:order-1 text-gray-700 mb-2 md:mb-0">
          <a
            class="text-gray-600 dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
            href="/privacy"
          >
            Privacy Policy
          </a>
        </div>

        <!-- Copyrights note -->
        <div class="text-gray-600 dark:text-gray-400 text-sm mr-4">
          &copy; TheOpenPresenter.com. All rights reserved.
        </div>
      </div>
    </div>
  </div>
</footer>
