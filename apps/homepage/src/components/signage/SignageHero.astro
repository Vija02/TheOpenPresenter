---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Hero for the screen pages (kids ministry, lobby). The right side is a
// drawn screens dashboard listing `rooms`.
interface Room {
  name: string;
  line: string;
  live?: boolean;
  /** What the screen is showing; placeholder lines when absent. */
  image?: ImageMetadata;
}

interface Props {
  eyebrow: string;
  title: string;
  /** Rendered after `title` in the brand gradient. */
  highlight: string;
  body: string;
  bullets: string[];
  rooms: Room[];
}

const { eyebrow, title, highlight, body, bullets, rooms } = Astro.props;
const liveCount = rooms.filter((r) => r.live).length;
---

<section>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="pt-32 pb-10 md:pb-16">
      <div class="md:grid md:grid-cols-12 md:gap-12 lg:gap-16 items-center">
        <div class="md:col-span-6 mb-10 md:mb-0 text-center md:text-left">
          <div
            class="inline-flex items-center text-sm font-semibold tracking-wide uppercase text-brand-500 mb-3"
            data-aos="fade-down"
          >
            {eyebrow}
          </div>
          <h1
            class="h1 lg:text-4xl mb-3 font-red-hat-display font-black leading-tight"
            data-aos="fade-down"
            data-aos-delay="50"
          >
            {title}
            <span
              class="bg-clip-text text-transparent bg-gradient-to-r from-brand-400 to-accent-500"
              >{highlight}</span
            >
          </h1>
          <p
            class="text-lg lg:text-xl mb-6 text-gray-700 dark:text-gray-300 leading-relaxed"
            data-aos="fade-down"
            data-aos-delay="100"
          >
            {body}
          </p>
          <div
            class="flex flex-col sm:flex-row justify-center md:justify-start gap-3"
            data-aos="fade-down"
            data-aos-delay="150"
          >
            <a
              class="btn text-on-brand bg-brand-500 hover:bg-brand-400 shrink-0"
              href="/register"
            >
              Start free
            </a>
            <a
              class="btn text-brand-500 bg-white hover:bg-gray-50 border border-brand-500 dark:bg-transparent dark:hover:bg-gray-800 shrink-0"
              href="/compare/prodisplay-alternative"
            >
              Compare with ProDisplay
            </a>
          </div>
          <ul
            class="max-w-sm sm:max-w-md mx-auto md:max-w-none text-gray-600 dark:text-gray-400 mt-8 -mb-2 text-left"
            data-aos="fade-down"
            data-aos-delay="200"
          >
            {
              bullets.map((item) => (
                <li class="flex items-center mb-2">
                  <svg
                    class="w-3 h-3 fill-current text-brand-400 mr-2 shrink-0"
                    viewBox="0 0 12 12"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Screens dashboard illustration -->
        <div class="md:col-span-6" data-aos="fade-up" data-aos-delay="300">
          <div
            class="rounded-lg bg-white dark:bg-gray-800 p-4 sm:p-5 shadow-2xl ring-1 ring-gray-200 dark:ring-gray-700"
            aria-hidden="true"
          >
            <div class="flex items-center justify-between mb-4">
              <span class="font-red-hat-display font-black text-gray-900 dark:text-gray-100">
                Screens
              </span>
              <span
                class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 dark:bg-brand-500/10 text-brand-600 dark:text-brand-400 text-xs font-semibold px-2.5 py-1"
              >
                <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
                {liveCount} of {rooms.length} live
              </span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              {
                rooms.map((room) => (
                  <div>
                    {room.image ? (
                      <Image
                        src={room.image}
                        alt=""
                        widths={[240, 480]}
                        sizes="(min-width: 768px) 180px, 45vw"
                        loading="eager"
                        class:list={[
                          "rounded bg-gray-900 aspect-video w-full object-cover",
                          !room.live && "opacity-40 grayscale",
                        ]}
                      />
                    ) : (
                      <div class="rounded bg-gray-900 aspect-video p-2 flex flex-col justify-end">
                        <div
                          class:list={[
                            "h-1.5 rounded mb-1 w-3/4",
                            room.live ? "bg-white/80" : "bg-white/20",
                          ]}
                        />
                        <div
                          class:list={[
                            "h-1.5 rounded w-1/2",
                            room.live ? "bg-white/50" : "bg-white/10",
                          ]}
                        />
                      </div>
                    )}
                    <div class="mt-1.5 flex items-center gap-1.5">
                      <span
                        class:list={[
                          "w-1.5 h-1.5 rounded-full shrink-0",
                          room.live ? "bg-brand-400" : "bg-gray-300 dark:bg-gray-600",
                        ]}
                      />
                      <span class="text-xs font-semibold text-gray-900 dark:text-gray-100 truncate">
                        {room.name}
                      </span>
                    </div>
                    <div class="text-[11px] text-gray-500 dark:text-gray-400 truncate">
                      {room.line}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
