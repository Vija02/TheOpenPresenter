---
import { Image } from "astro:assets";
import LiveDemoQr from "../demo/LiveDemoQr.astro";
import remoteImg from "../../assets/images/home/hero-remote.png";
import remoteSlidesImg from "../../assets/images/home/hero-remote-slides.png";
// where the cursor clicks on those screenshots, measured when they were taken
// (tools/remote-screenshots.mjs captures both from the running app)
import remoteBoxes from "../../data/hero-remote.json";
import devicesSvg from "../../assets/illustrations/hero-devices.svg?raw";
import devicesMobileSvg from "../../assets/illustrations/hero-devices-mobile.svg?raw";
// What the cursor does on the remote, in order, before it loops: the songs,
// then over to the Slides tab for the sermon, then back. Boxes are percentages
// of the remote screenshot, from hero-remote.json.
// - lyric: `lines` on the main screen, `hl` the matching line range on the
//   chord sheet (lyric lines only, counted from 0 without section headers)
// - tab: switches the remote to that tab; the screens stay as they are
// - slide: a sermon slide (index into DECK in tools/sunday-scenes.py); the
//   screens switch to it and the tablet becomes the pastor's speaker view,
//   with `notes` as the speaker notes. `by: "pastor"` means the pastor moves
//   on with Next on the tablet instead of the tech team clicking the remote.
// - ink: no click on the remote; the pastor's cursor picks `tool` on the
//   tablet and draws the slide's marks, which show on every screen
// A lyric's `next` is the song's following slide, which the confidence
// monitor shows as coming up (even where the demo skips ahead). For slides it
// shows the next slide itself.
const slide = (n: number, notes: string) => ({
  kind: "slide", slide: n, box: remoteBoxes.slides[n], notes,
});
const lyrics = [
  { song: "how", lines: ["When the music fades", "All is stripped away", "And I simply come"], hl: [0, 2], box: remoteBoxes.lyrics[0], next: ["Longing just to bring", "something that's of worth", "That will bless Your heart"] },
  { song: "how", lines: ["Longing just to bring", "something that's of worth", "That will bless Your heart"], hl: [3, 5], box: remoteBoxes.lyrics[1], next: ["I'll bring You more than a song", "For a song in itself", "is not what You have required"] },
  { song: "bml", lines: ["Holy, there is no one like You", "There is none beside You", "Open up my eyes in wonder", "Show me who You are and fill me"], hl: [15, 18], box: remoteBoxes.lyrics[2], next: ["With Your heart and lead me", "In Your love to those around me"] },
].map((s) => ({ kind: "lyric", ...s }));
const sequence = [
  ...lyrics,
  { kind: "tab", tab: "slides", box: remoteBoxes.tabs.slides },
  slide(0, "Read slowly. The sign is God's, set in the sky for us to see."),
  { ...slide(1, "God remembers. Not because He forgets, but because He acts."), by: "pastor" },
  { kind: "ink", tool: "highlight" },
  { kind: "ink", tool: "pencil" },
  { ...slide(2, "Everlasting. Close in prayer, then hand back to the band."), by: "pastor" },
  { kind: "tab", tab: "lyrics", box: remoteBoxes.tabs.lyrics },
];

// Screens beside the remote, generated by tools/sunday-scenes.py. They start on
// the first slide and src/scripts/hero-remote.ts moves them along as the cursor
// clicks. The motion backgrounds are the demo songs' Mux videos, saved as MP4.
const devicesFill: Record<string, string> = {
  __BG_HOW__: "/videos/home/how-bg.mp4",
  __BG_BML__: "/videos/home/bml-bg.mp4",
  __POSTER_HOW__: "/videos/home/how-bg.jpg",
  __POSTER_BML__: "/videos/home/bml-bg.jpg",
};
const fill = (svg: string) => Object.entries(devicesFill).reduce((out, [k, v]) => out.replaceAll(k, v), svg);
const devices = fill(devicesSvg);
const devicesMobile = fill(devicesMobileSvg);
const [lx, ly, lw, lh] = lyrics[0].box;

// The people named in the headline, each in the colour of their cursor on the
// product shot below (text uses a lighter tint so it reads on the dark page).
const roles = [
  { word: "pastor", text: "#FF8A6A", cursor: "#E4572E" },
  { word: "worship", text: "#F5B547", cursor: "#D98A1C" },
  { word: "tech team", text: "#A99BFF", cursor: "#6C5CE7" },
];
---

<section id="demo" class="scroll-mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="pt-32 pb-10 md:pt-40 md:pb-16">
      <!-- Centered pitch -->
      <div class="max-w-3xl mx-auto text-center">
        <h1
          class="h1 font-red-hat-display font-black leading-tight mb-5 text-balance max-sm:text-[2rem] lg:text-[3.6rem] xl:text-5xl lg:-mx-28 xl:-mx-44"
          data-aos="fade-down"
        >
          Church software that connects<br class="hidden lg:block" />
          <span class="lg:whitespace-nowrap"
            >your {
              roles.map((role, i) => (
                <>
                  <span class="inline-block whitespace-nowrap mr-[0.2em]"
                    ><span class="relative" style={`color: ${role.text};`}
                      >{role.word}<svg
                        class="absolute left-[calc(100%-0.04em)] top-[0.1em] w-[0.34em] h-[0.34em] drop-shadow"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        ><path
                          d="M3 2l17 8.5-7.2 1.8L9 20z"
                          fill={role.cursor}
                          stroke="#fff"
                          stroke-width="1.6"
                          stroke-linejoin="round"
                        /></svg
                      ></span
                    >{i === 0 ? "," : ""}</span
                  >{i === 0 ? " " : i === 1 ? " and " : ""}
                </>
              ))
            }</span
          >
        </h1>
        <p
          class="text-lg md:text-xl text-gray-600 dark:text-gray-400 mb-8"
          data-aos="fade-down"
          data-aos-delay="75"
        >
          Lyrics, slides, bible and music in your browser. Plan the service
          together from home, then run it from any phone or laptop on Sunday.
          Open source and free to start.
        </p>
        <div
          class="flex flex-col sm:flex-row gap-3 justify-center mb-5"
          data-aos="fade-down"
          data-aos-delay="150"
        >
          <a
            class="btn text-white bg-teal-500 hover:bg-teal-400"
            href="/register"
          >
            Sign up free
          </a>
          <a
            class="btn text-teal-500 bg-white hover:bg-gray-50 border border-teal-500 dark:bg-transparent dark:hover:bg-gray-800"
            href="#together"
          >
            See how it works
          </a>
        </div>
        <p
          class="text-sm text-gray-500 dark:text-gray-400"
          data-aos="fade-down"
          data-aos-delay="200"
        >
          Free for churches under 50 weekly attendance, storage and AI
          included. <a
            href="/church/sponsorship"
            class="text-teal-600 dark:text-teal-400 hover:underline font-medium"
            >See the sponsorship</a
          >.
        </p>
      </div>

      <!-- Pairing QR, centered under the buttons. Shares the "demo" instance
           with the floating widget, so both show the same code. -->
      <div class="max-w-2xl mx-auto">
        <LiveDemoQr
          instance="demo"
          church
          showCta={false}
          showFeatures={false}
          class="md:justify-center"
        >
          <Fragment slot="hint">
            No signup. You'll be running a real presentation on this screen,
            from your phone, in about ten seconds.
          </Fragment>
        </LiveDemoQr>
      </div>

      <!-- Product shot: the remote screenshot laid over the top left of the
           drawing of the screens it drives, wider than the text column on large
           screens. Its box matches REMOTE in tools/sunday-scenes.py (x 0, y 24,
           600 wide on the 1000x724 canvas). Phones get their own drawing,
           stacked under the remote. -->
      <div class="hero-shot relative mx-auto mt-12 md:mt-16 xl:-mx-28">
        <div class="hero-devices hidden md:block" set:html={devices} />
        <div class="md:hidden mb-2 text-[11px] font-bold tracking-[0.11em] uppercase text-[#9B9CA3]">
          Tech PC / tablet / phone
        </div>
        <div
          class="relative z-10 md:absolute md:left-0 md:top-[3.315%] md:w-[60%]"
          data-hero-remote
          data-steps={JSON.stringify(sequence)}
        >
          <div class="relative bg-white shadow-2xl ring-1 ring-black/10">
            <Image
              class="w-full h-auto block"
              src={remoteImg}
              alt="TheOpenPresenter remote, with lyrics for The Heart of Worship and Build My Life and a Slides scene for the sermon"
              widths={[800, 1200, 1600]}
              sizes="(min-width: 1280px) 820px, (min-width: 768px) 60vw, 100vw"
              loading="eager"
            />
            <!-- the Slides tab, faded in over the lyrics one when the cursor
                 clicks it in the sidebar -->
            <Image
              class="hero-remote-slides absolute inset-0 w-full h-auto block opacity-0"
              src={remoteSlidesImg}
              alt=""
              widths={[800, 1200, 1600]}
              sizes="(min-width: 1280px) 820px, (min-width: 768px) 60vw, 100vw"
              loading="lazy"
            />
            <!-- the slide on screen, outlined in red like the app does -->
            <div
              class="hero-live absolute ring-inset ring-[1.5px] md:ring-2 ring-[#E5302E] pointer-events-none"
              style={`left: ${lx}%; top: ${ly}%; width: ${lw}%; height: ${lh}%;`}
              aria-hidden="true"
            >
            </div>
            <div
              class="hero-cursor absolute w-0 h-0 pointer-events-none"
              style={`left: ${lx + lw * 0.6}%; top: ${ly + lh * 0.6}%;`}
              aria-hidden="true"
            >
              <span class="hero-click absolute -left-4 -top-4 w-8 h-8 rounded-full bg-[#6C5CE7]/30"></span>
              <!-- the tech team runs the remote, in their colour from the headline -->
              <svg class="absolute -left-0.5 -top-0.5 w-5 h-5 sm:w-6 sm:h-6 drop-shadow-md" viewBox="0 0 24 24">
                <path
                  d="M3 2l17 8.5-7.2 1.8L9 20z"
                  fill="#6C5CE7"
                  stroke="#fff"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
              </svg>
              <span
                class="hero-tag absolute left-3.5 top-4 sm:left-4 sm:top-5 whitespace-nowrap rounded px-1.5 py-px text-[10px] sm:text-xs font-bold text-white bg-[#6C5CE7] shadow"
                >Tech team</span
              >
            </div>
          </div>
        </div>
        <div class="hero-devices md:hidden" set:html={devicesMobile} />
      </div>
    </div>
  </div>
</section>

<script>
  import "../../scripts/hero-remote";
</script>

<style>
  .hero-cursor {
    transition:
      left 0.55s cubic-bezier(0.45, 0, 0.2, 1),
      top 0.55s cubic-bezier(0.45, 0, 0.2, 1);
  }
  /* where the name tag would run off the screen it hangs left instead */
  .hero-cursor.flip .hero-tag {
    left: auto;
    right: 0.25rem;
  }
  .hero-live {
    transition: opacity 0.2s;
  }
  .hero-remote-slides {
    transition: opacity 0.35s;
  }
  /* The pastor's turn (hero-remote.ts sets pastor-turn on .hero-shot): the
     remote steps back and the tablet lights up in the pastor's colour, so
     eyes move to where the action is. */
  [data-hero-remote] {
    transition: opacity 0.4s;
  }
  .hero-shot.pastor-turn [data-hero-remote] {
    opacity: 0.4;
  }
  .hero-devices :global(.tablet-frame) {
    transition:
      stroke 0.4s,
      stroke-width 0.4s;
  }
  .hero-shot.pastor-turn .hero-devices :global(.tablet-frame) {
    stroke: #e4572e;
    stroke-width: 3;
    animation: pastor-glow 1.6s ease-in-out infinite;
  }
  @keyframes pastor-glow {
    50% {
      filter: drop-shadow(0 0 10px rgba(228, 87, 46, 0.65));
    }
  }
  .hero-devices :global(.tablet-label) {
    transition: fill 0.4s;
  }
  .hero-shot.pastor-turn .hero-devices :global(.tablet-label) {
    fill: #ff8a6a;
  }
  .hero-devices :global(.turn-chip),
  .hero-devices :global(.pv-cursor) {
    opacity: 0;
    transition: opacity 0.4s;
  }
  .hero-shot.pastor-turn .hero-devices :global(.turn-chip),
  .hero-shot.pastor-turn .hero-devices :global(.pv-cursor) {
    opacity: 1;
  }
  .hero-click {
    opacity: 0;
    transform: scale(0.3);
  }
  .hero-cursor.clicking .hero-click {
    animation: hero-click 0.45s ease-out;
  }
  @keyframes hero-click {
    0% {
      opacity: 0.9;
      transform: scale(0.3);
    }
    100% {
      opacity: 0;
      transform: scale(1.4);
    }
  }
  .hero-devices :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* the tablet sits on the drawing's edge; let its glow spill past it */
  .hero-devices > :global(svg) {
    overflow: visible;
  }
  .hero-devices :global(.live-slide) {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
  }
  .hero-devices :global(.live-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s;
  }
  .hero-devices :global(.live-bg.is-hidden) {
    opacity: 0;
  }
  .hero-devices :global(.live-lyric) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4%;
    text-align: center;
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 700;
    line-height: 1.2;
    text-shadow: 0 0.06em 0.2em rgba(0, 0, 0, 0.8);
  }
  /* Slides mode: the sermon slide replaces the lyric and its background, and
     the musician's chords give way to the pastor's tablet. */
  .hero-devices.is-slides :global(.live-bg),
  .hero-devices.is-slides :global(.live-lyric),
  .hero-devices.is-slides :global(.tablet-chords),
  .hero-devices:not(.is-slides) :global(.tablet-pastor) {
    display: none;
  }
  /* !important: the slides are laid out with inline styles (display: flex) */
  .hero-devices:not(.is-slides) :global(.deck-slide),
  .hero-devices :global(.deck-slide:not(.is-current)) {
    display: none !important;
  }
  /* the pastor's marks, drawn in by hero-remote.ts as their cursor traces
     them; hidden until then, since a zero-length dash still paints its cap */
  .hero-devices :global(.ink path) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    visibility: hidden;
  }
  .hero-devices :global(.ink path.is-drawn) {
    visibility: visible;
  }
  /* the pastor's speaker view */
  .hero-devices :global(.pv-tool.is-on) {
    background: #212529;
    color: #fff;
  }
  /* a preview under the pastor's cursor, like the speaker view's hover: a
     stronger outline, on a layer above the slide inside, and label */
  .hero-devices :global(.pv-preview .deck::after) {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    box-shadow: inset 0 0 0 2px transparent;
    transition: box-shadow 0.15s;
  }
  .hero-devices :global(.pv-preview.is-hover .deck::after) {
    box-shadow: inset 0 0 0 2px #6c757d;
  }
  .hero-devices :global(.pv-preview.is-hover .deck + div) {
    color: #212529 !important;
  }
  .hero-devices :global(.pv-cursor) {
    transition:
      left 0.5s cubic-bezier(0.45, 0, 0.2, 1),
      top 0.5s cubic-bezier(0.45, 0, 0.2, 1);
  }
  .hero-devices :global(.pv-cursor.is-drawing) {
    transition: none;
  }
  .hero-devices :global(.pv-click) {
    position: absolute;
    left: -10px;
    top: -10px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(228, 87, 46, 0.35);
    opacity: 0;
  }
  .hero-devices :global(.pv-cursor.clicking .pv-click) {
    animation: hero-click 0.45s ease-out;
  }
  /* the confidence monitor's NEXT: the next lyric, or the next slide */
  .hero-devices.is-slides :global(.cm-next-text),
  .hero-devices:not(.is-slides) :global(.cm-next-deck) {
    display: none;
  }
  .hero-devices :global(.cs-song.is-hidden) {
    display: none;
  }
  .hero-devices :global(.cs-scroll) {
    transition: transform 0.4s ease;
  }
  .hero-devices :global(.cs-chord) {
    fill: #f5b547;
    font-weight: 700;
  }
  .hero-devices :global(.cs-lyric) {
    fill: #e5e7eb;
  }
  /* the lines on screen get a bar on the left */
  .hero-devices :global(.cs-bar) {
    fill: #f5b547;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .hero-devices :global(.cs-line.is-current .cs-bar) {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-devices :global(.cs-scroll),
    .hero-devices :global(.live-bg) {
      transition: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-devices :global(.scene-link) {
      animation: hero-flow 1.2s linear infinite;
    }
  }
  @keyframes hero-flow {
    to {
      stroke-dashoffset: -10;
    }
  }
</style>
