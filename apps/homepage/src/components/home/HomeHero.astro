---
import { Image } from "astro:assets";
import LiveDemoQr from "../demo/LiveDemoQr.astro";
import WindowFrame from "../ui/WindowFrame.astro";
import heroImg from "../../assets/images/app-lyrics-presenter.png";
---

<section id="demo" class="scroll-mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="pt-32 pb-10 md:pt-40 md:pb-16">
      <!-- Centered pitch -->
      <div class="max-w-3xl mx-auto text-center">
        <h1
          class="h1 font-red-hat-display font-black leading-tight mb-5"
          data-aos="fade-down"
        >
          Simple, open-source
          <span
            class="bg-clip-text text-transparent bg-gradient-to-r from-teal-400 to-purple-500"
            >ProPresenter alternative</span
          >
        </h1>
        <p
          class="text-lg md:text-xl text-gray-600 dark:text-gray-400 mb-8"
          data-aos="fade-down"
          data-aos-delay="75"
        >
          Presentation software for small churches. Run your service from any
          phone or laptop, with your whole team controlling it at once. Open
          source and free to start.
        </p>
        <div
          class="flex flex-col sm:flex-row gap-3 justify-center mb-5"
          data-aos="fade-down"
          data-aos-delay="150"
        >
          <a
            class="btn text-white bg-teal-500 hover:bg-teal-400"
            href="/register"
          >
            Sign up free
          </a>
          <a
            class="btn text-teal-500 bg-white hover:bg-gray-50 border border-teal-500 dark:bg-transparent dark:hover:bg-gray-800"
            href="/compare/propresenter-alternative"
          >
            Compare to ProPresenter
          </a>
        </div>
        <p
          class="text-sm text-gray-500 dark:text-gray-400"
          data-aos="fade-down"
          data-aos-delay="200"
        >
          Free for churches under 50 weekly attendance, storage and AI
          included. <a
            href="/church/sponsorship"
            class="text-teal-600 dark:text-teal-400 hover:underline font-medium"
            >See the sponsorship</a
          >.
        </p>
      </div>

      <!-- Pairing QR, centered under the buttons. Shares the "demo" instance
           with the floating widget, so both show the same code. -->
      <div class="max-w-2xl mx-auto">
        <LiveDemoQr
          instance="demo"
          showCta={false}
          showFeatures={false}
          class="md:justify-center"
        >
          <Fragment slot="hint">
            No signup. You'll be running a real presentation on this screen,
            from your phone, in about ten seconds.
          </Fragment>
        </LiveDemoQr>
      </div>

      <!-- Product shot -->
      <div
        class="max-w-5xl mx-auto mt-12 md:mt-16"
        data-aos="fade-up"
        data-aos-delay="250"
      >
        <WindowFrame>
          <Image
            class="w-full h-auto block"
            src={heroImg}
            alt="TheOpenPresenter lyrics view, with slides built for three worship songs"
            loading="eager"
          />
        </WindowFrame>
      </div>
    </div>
  </div>
</section>
