---
// "With software you already use": service plans feed in from the top, slides
// from the bottom, all landing in one live service. Logos are the same icons
// the app uses.
import Logo from "../ui/Logo.astro";
import planningCenter from "../../assets/logos/planningcenter.svg?raw";
import churchSuite from "../../assets/logos/churchsuite.svg?raw";
import canva from "../../assets/logos/canva.svg?raw";
import googleSlides from "../../assets/logos/google-slides.svg?raw";
import powerPoint from "../../assets/logos/powerpoint.svg?raw";
import pdf from "../../assets/logos/pdf.svg?raw";
import images from "../../assets/logos/images.svg?raw";

const plans = [
  { name: "Planning Center", logo: planningCenter },
  { name: "ChurchSuite", logo: churchSuite },
];

const slides = [
  { name: "Canva", logo: canva },
  { name: "Google Slides", logo: googleSlides },
  { name: "PowerPoint", logo: powerPoint },
  { name: "PDF", logo: pdf },
  { name: "Images", logo: images },
];

// Horizontal centre of column i in an n-column grid with the given gap, so the
// connector lines land on the middle of each tile.
const centre = (i: number, n: number, gap: string) =>
  `left: calc((100% - ${n - 1} * ${gap}) / ${n} * ${i + 0.5} + ${i} * ${gap});`;

const line = "absolute border-teal-500/70 border-dashed";
const tile =
  "flex items-center rounded-xl bg-white text-gray-900 shadow-lg ring-1 ring-black/5";
---

<section>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-12 md:py-20 border-t border-gray-200 dark:border-gray-800">
      <div class="max-w-3xl mx-auto text-center pb-10 md:pb-14">
        <h2 class="h2 font-red-hat-display mb-4">
          Works with software<br class="hidden sm:block" />
          <span class="text-teal-400">you already use</span>
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-400">
          Keep planning where you plan and designing where you design. It all
          comes together in one live service, with nothing to rebuild.
        </p>
      </div>

      <div class="max-w-3xl mx-auto" data-aos="fade-up">
        <!-- Service plans -->
        <div class="text-center mb-4">
          <div class="text-xs font-semibold uppercase tracking-wider text-teal-500">
            Songs &amp; service plans
          </div>
          <div class="text-gray-600 dark:text-gray-400">
            Import your setlist and lyrics straight from your plan.
          </div>
        </div>
        <div class="grid grid-cols-2 gap-6 max-w-xl mx-auto">
          {
            plans.map((p) => (
              <div class:list={[tile, "justify-center gap-3 px-4 py-4 sm:py-5"]}>
                <span class="w-7 h-7 sm:w-8 sm:h-8 shrink-0 [&>svg]:w-full [&>svg]:h-full" set:html={p.logo} />
                <span class="font-red-hat-display font-black text-base sm:text-lg">{p.name}</span>
              </div>
            ))
          }
        </div>

        <!-- Connector: plans to hub -->
        <div class="relative h-10 max-w-xl mx-auto" aria-hidden="true">
          {[0, 1].map((i) => (
            <div class:list={[line, "top-0 h-1/2 border-l-2"]} style={centre(i, 2, "1.5rem")} />
          ))}
          <div
            class:list={[line, "top-1/2 border-t-2"]}
            style="left: calc((100% - 1.5rem) / 4); right: calc((100% - 1.5rem) / 4);"
          />
          <div class:list={[line, "top-1/2 bottom-0 left-1/2 border-l-2"]} />
        </div>

        <!-- Hub -->
        <div class="flex justify-center">
          <div
            class="flex flex-col items-center gap-2 rounded-2xl border-2 border-teal-500 bg-white px-8 py-5 shadow-2xl ring-8 ring-teal-500/15 [&_.logo-text-color]:fill-gray-900!"
          >
            <Logo />
            <span class="text-sm font-semibold text-gray-600">
              Everything in one live service
            </span>
          </div>
        </div>

        <!-- Connector: hub to slide sources -->
        <div class="relative h-10" aria-hidden="true">
          <div class:list={[line, "top-0 h-1/2 left-1/2 border-l-2"]} />
          <div
            class:list={[line, "top-1/2 border-t-2"]}
            style="left: calc((100% - 4rem) / 10); right: calc((100% - 4rem) / 10);"
          />
          {slides.map((_, i) => (
            <div class:list={[line, "top-1/2 bottom-0 border-l-2"]} style={centre(i, 5, "1rem")} />
          ))}
        </div>

        <!-- Slide sources -->
        <div class="grid grid-cols-5 gap-4">
          {
            slides.map((s) => (
              <div class:list={[tile, "flex-col justify-center gap-2 px-1 py-4 sm:py-5 text-center"]}>
                <span class="w-8 h-8 sm:w-10 sm:h-10 [&>svg]:w-full [&>svg]:h-full" set:html={s.logo} />
                <span class="text-[10px] sm:text-sm font-semibold leading-tight">{s.name}</span>
              </div>
            ))
          }
        </div>
        <div class="text-center mt-4">
          <div class="text-xs font-semibold uppercase tracking-wider text-teal-500">
            Slides
          </div>
          <div class="text-gray-600 dark:text-gray-400">
            Bring the slides you already made. Google Slides stays in sync.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
