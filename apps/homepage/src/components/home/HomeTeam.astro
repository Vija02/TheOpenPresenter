---
// "Prepare at home, together": the team preparing the service during the
// week, one row per step. The first step's drawing is generated by
// tools/sunday-scenes.py; edit that and rerun it rather than the SVG.
import editAnywhereSvg from "../../assets/illustrations/edit-anywhere.svg?raw";
import GuestUploadChat from "./GuestUploadChat.astro";

const before = [
  {
    title: "Anyone can edit, any time",
    body: "The whole team works on the same service from wherever they are. One adds the songs, another fixes a typo, the pastor drops in the sermon slides. Every change is live for everyone.",
    chat: false,
  },
  {
    title: "Guests upload their own slides",
    body: "Send a link instead of chasing files. Their PowerPoint, PDF or Canva files shows up in the service directly ready to show. They don't need an account.",
    chat: true,
  },
];

---

<section id="together" class="scroll-mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-12 md:py-20 border-t border-gray-200 dark:border-gray-800">
      <div class="max-w-3xl mx-auto text-center pb-10 md:pb-12">
        <h2 class="h2 font-red-hat-display mb-4">
          Prepare at home, <span class="text-teal-400">together</span>
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-400">
          One live service the whole team shares. Everyone adds their part from
          wherever they are, whenever suits them.
        </p>
      </div>

      <!-- one row per step: text beside its picture, sides alternating -->
      <div class="max-w-5xl mx-auto space-y-12 md:space-y-16">
        {
          before.map((step, i) => (
            <article
              class="grid gap-6 md:gap-12 md:grid-cols-2 items-center"
              data-aos="fade-up"
            >
              <div class:list={[i % 2 === 1 && "md:order-2"]}>
                <h3 class="text-2xl font-red-hat-display font-black mb-3">{step.title}</h3>
                <p class="text-lg text-gray-600 dark:text-gray-400">{step.body}</p>
              </div>
              {step.chat ? (
                <GuestUploadChat class="w-full max-w-md md:justify-self-center md:order-1" />
              ) : (
              <div
                class="edit-anywhere w-full overflow-hidden rounded-lg shadow-lg ring-1 ring-white/5"
                set:html={editAnywhereSvg}
              />
              )}
            </article>
          ))
        }
      </div>

      <p class="mt-14 md:mt-16 text-center text-gray-600 dark:text-gray-400">
        Everything connects over Wi-Fi. No cable runs, capture cards or
        converters.
        <a
          href="/how-to/present-on-tv"
          class="text-teal-600 dark:text-teal-400 hover:underline font-medium whitespace-nowrap"
          >Put it on a TV &rarr;</a
        >
      </p>
    </div>
  </div>
</section>

<style>
  .edit-anywhere :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Edits flowing between the houses and the service */
  @media (prefers-reduced-motion: no-preference) {
    .edit-anywhere :global(.scene-link) {
      animation: edit-flow 1.2s linear infinite;
    }
  }
  @keyframes edit-flow {
    to {
      stroke-dashoffset: -10;
    }
  }
</style>
