---
// Closing call to action. Defaults to the church-facing wording used on most
// of the site; venue pages pass their own.
interface Props {
  title?: string;
  /** Second line, rendered in the teal-to-purple gradient. */
  highlight?: string;
  body?: string;
  /** Show the "Try the live demo" secondary button. */
  demo?: boolean;
}

const {
  title = "Ready for this Sunday?",
  highlight = "Start free.",
  body = "No card and no licence fee, and no limit on how many people can help run it.",
  demo = true,
} = Astro.props;
---

<section class="bg-gray-100 dark:bg-gray-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div
      class="py-16 md:py-20 flex flex-col md:flex-row md:items-center md:justify-between gap-8 text-center md:text-left"
    >
      <div data-aos="fade-up">
        <h2 class="h3 font-red-hat-display font-black leading-tight">
          {title}<br />
          <span
            class="inline-block pb-1 bg-clip-text text-transparent bg-gradient-to-r from-teal-400 to-purple-500"
          >
            {highlight}
          </span>
        </h2>
        <p class="mt-3 text-gray-600 dark:text-gray-400">
          {body}
        </p>
      </div>
      <div
        class="flex flex-col sm:flex-row justify-center md:justify-end gap-3 shrink-0"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <a class="btn text-white bg-teal-500 hover:bg-teal-400" href="/register">
          Sign up free
        </a>
        {
          demo && (
            <a
              class="btn text-teal-500 bg-white hover:bg-gray-50 border border-teal-500 dark:bg-transparent dark:hover:bg-gray-700"
              href="#"
              data-init-demo-jump
            >
              Try the live demo
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/demo-jump";
</script>
