---
// A ticked list for a FeatureRow.
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="text-gray-600 dark:text-gray-400 text-base">
  {
    items.map((item) => (
      <li class="flex items-start mb-2">
        <svg class="w-3 h-3 mt-1.5 fill-current text-brand-400 mr-2 shrink-0" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z" />
        </svg>
        <span>{item}</span>
      </li>
    ))
  }
</ul>
