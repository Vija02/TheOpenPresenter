---
// Top-down plan of a hall: with a booth at the back and a cable run to the
// stage, or with one case on stage and a tablet in the seats.
interface Props {
  booth: boolean;
}

const { booth } = Astro.props;
const seats = [0, 1, 2, 3, 4, 5].flatMap((r) =>
  [0, 1, 2, 3, 4, 5].map((c) => ({ x: 34 + c * 30 + (c > 2 ? 14 : 0), y: 84 + r * 26 })),
);
// The seat the tablet holder sits in
const held = { x: 34 + 4 * 30 + 14, y: 84 + 3 * 26 };
---

<svg viewBox="0 0 240 290" class="w-full h-auto" aria-hidden="true">
  <rect x="2" y="2" width="236" height="286" class="fill-white dark:fill-gray-900 stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />
  <!-- Stage and screen -->
  <rect x="2" y="2" width="236" height="50" class="fill-gray-100 dark:fill-gray-800" />
  <rect x="70" y="10" width="100" height="6" class="fill-gray-800 dark:fill-gray-300" />
  {seats.map((s) => <rect x={s.x} y={s.y} width="20" height="14" class="fill-gray-200 dark:fill-gray-700" />)}
  {
    booth ? (
      <>
        <path
          d="M170 13 H226 V250 H190"
          fill="none"
          stroke-width="3"
          class="stroke-red-400"
        />
        <rect x="80" y="240" width="110" height="34" class="fill-gray-700" />
        <rect x="100" y="246" width="24" height="16" class="fill-gray-300" />
        <rect x="140" y="246" width="34" height="20" class="fill-gray-500" />
        <circle cx="135" cy="282" r="5" class="fill-red-400" />
      </>
    ) : (
      <>
        <rect x="184" y="20" width="40" height="24" class="fill-gray-800 dark:fill-gray-500" />
        <rect x="190" y="26" width="28" height="12" class="fill-brand-500" />
        <rect x={held.x - 2} y={held.y - 2} width="24" height="18" class="fill-brand-500" />
        <path
          d={`M${held.x + 10} ${held.y - 8} L204 50`}
          fill="none"
          stroke-width="2"
          stroke-dasharray="3 4"
          class="stroke-brand-500"
        />
      </>
    )
  }
</svg>
