---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "prose prose-lg dark:prose-invert max-w-none",
    "prose-headings:font-red-hat-display prose-headings:font-black prose-headings:tracking-tight prose-headings:text-gray-900 dark:prose-headings:text-gray-100",
    // Sized against the H1 in BlogHeader (2.5rem at md+). The theme's own
    // --text-3xl is 2.63rem, so the usual `md:text-3xl` here would render H2
    // larger than the title.
    "prose-h2:text-2xl md:prose-h2:text-[1.9rem] prose-h2:mt-12 prose-h2:mb-4",
    "prose-h3:text-xl md:prose-h3:text-[1.35rem] prose-h3:mt-8 prose-h3:mb-2",
    "prose-p:text-gray-600 dark:prose-p:text-gray-300",
    "prose-li:text-gray-600 dark:prose-li:text-gray-300",
    "prose-strong:text-gray-900 dark:prose-strong:text-gray-100",
    "prose-a:text-teal-600 dark:prose-a:text-teal-400 prose-a:font-medium prose-a:no-underline hover:prose-a:underline",
    "prose-blockquote:border-l-teal-500 prose-blockquote:not-italic prose-blockquote:font-normal prose-blockquote:text-gray-600 dark:prose-blockquote:text-gray-300",
    "prose-img:rounded-lg prose-img:border prose-img:border-gray-200 dark:prose-img:border-gray-800 prose-img:shadow-sm",
    "prose-video:max-w-full prose-video:h-auto prose-video:my-0 prose-video:mx-auto prose-video:rounded-lg prose-video:border prose-video:border-gray-200 dark:prose-video:border-gray-800 prose-video:shadow-sm",
    // Markdown images are wrapped into <figure> by rehype-image-figures, so
    // images and videos share one frame and one caption style.
    "prose-figure:mb-8",
    "prose-img:my-0 prose-img:mx-auto",
    "prose-figcaption:text-base prose-figcaption:italic prose-figcaption:text-center prose-figcaption:mt-2 prose-figcaption:text-gray-500 dark:prose-figcaption:text-gray-400",
    "prose-em:text-gray-500 dark:prose-em:text-gray-400",
    // Inline code only. A bare `prose-code:` would also match the <code> that
    // Shiki nests inside <pre>, drawing a second background box on top of the
    // code block's own. Fenced blocks keep Shiki's colours untouched.
    "[&_:not(pre)>code]:rounded [&_:not(pre)>code]:bg-gray-100 dark:[&_:not(pre)>code]:bg-gray-800 [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:text-[0.9em] [&_:not(pre)>code]:font-normal [&_:not(pre)>code]:text-gray-900 dark:[&_:not(pre)>code]:text-gray-100",
    // Typography renders literal backticks around inline code via ::before
    // and ::after.
    "prose-code:before:content-none prose-code:after:content-none",
    "prose-pre:rounded-lg prose-pre:border prose-pre:border-gray-200 dark:prose-pre:border-gray-800",
    "prose-hr:border-gray-200 dark:prose-hr:border-gray-800",
    "prose-th:text-gray-900 dark:prose-th:text-gray-100 prose-td:text-gray-600 dark:prose-td:text-gray-300",
    className,
  ]}
>
  <slot />
</div>
