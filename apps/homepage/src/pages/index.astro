---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import PageIllustration from "../components/PageIllustration.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeTeam from "../components/home/HomeTeam.astro";
import HomeIntegrations from "../components/home/HomeIntegrations.astro";
import HomeWhy from "../components/home/HomeWhy.astro";
import TestimonialsBlocks from "../components/TestimonialsBlocks.astro";
import HomeSwitching from "../components/home/HomeSwitching.astro";
import HomeWhoItsFor from "../components/home/HomeWhoItsFor.astro";
import HomeCta from "../components/home/HomeCta.astro";
---

<DefaultLayout
  title="TheOpenPresenter | Free Church Presentation Software for Your Whole Team"
  description="Open-source presentation software for churches. Plan the service together from home, then run it from any phone or laptop on Sunday. Free to start, no licence fee."
>
  <!-- Page illustration -->
  <div
    class="relative max-w-6xl mx-auto h-0 pointer-events-none -z-1"
    aria-hidden="true"
  >
    <PageIllustration />
  </div>
  <HomeHero />
  <HomeTeam />
  <HomeIntegrations />
  <HomeWhy />
  <TestimonialsBlocks />
  <HomeSwitching />
  <HomeWhoItsFor />
  <HomeCta />
</DefaultLayout>
