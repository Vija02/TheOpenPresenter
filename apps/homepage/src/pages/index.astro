---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import PageIllustration from "../components/PageIllustration.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeWhy from "../components/home/HomeWhy.astro";
import TestimonialsBlocks from "../components/TestimonialsBlocks.astro";
import HomeComparison from "../components/home/HomeComparison.astro";
import HomeHonest from "../components/home/HomeHonest.astro";
import HomeWhoItsFor from "../components/home/HomeWhoItsFor.astro";
import HomeCta from "../components/home/HomeCta.astro";
---

<DefaultLayout
  title="TheOpenPresenter | Free, Open-Source ProPresenter Alternative"
  description="Open-source presentation software for small churches. Run your service from any phone or laptop, with your whole team at once. Free to start, no licence fee."
>
  <!-- Page illustration -->
  <div
    class="relative max-w-6xl mx-auto h-0 pointer-events-none -z-1"
    aria-hidden="true"
  >
    <PageIllustration />
  </div>
  <HomeHero />
  <HomeWhy />
  <TestimonialsBlocks />
  <HomeComparison />
  <HomeHonest />
  <HomeWhoItsFor />
  <HomeCta />
</DefaultLayout>
