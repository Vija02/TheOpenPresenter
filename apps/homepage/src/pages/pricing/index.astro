---
import DefaultLayout from "../../layouts/DefaultLayout.astro";
import PageIllustration from "../../components/PageIllustration.astro";
import CtaSignup from "@/components/CtaSignup.astro";

const plans = [
  {
    name: "Free",
    blurb: "For small churches, mid-week groups, and trying us out.",
    price: "&pound;0",
    unit: "forever",
    note: "no time limit &middot; no card needed",
    cta: { label: "Sign up free", href: "/register", primary: false },
    features: [
      "Unlimited users, all at once",
      "Up to 5 connected displays",
      "1 GB storage",
      "All official plugins",
      "PowerPoint import and Google Slides sync",
      "Community support",
    ],
  },
  {
    name: "Cloud",
    blurb: "For churches that need more storage and the AI tools.",
    price: "&pound;19",
    unit: "/month",
    note: "or &pound;190 a year, two months free",
    cta: { label: "Start free, upgrade later", href: "/register", primary: true },
    highlight: "Most popular",
    featuresHeading: "Everything in Free, plus",
    features: [
      "Unlimited connected displays",
      "Drive main screen, confidence monitor, and signage from one synchronised show",
      "Guest portal, so a visiting speaker can present from their own device",
      "50 GB storage",
      "AI lyric formatting",
      "Priority support",
      "Cancel any time, no lock-in",
    ],
  },
  {
    name: "Self-host",
    blurb: "Keep everything on your own hardware and network.",
    price: "Open source",
    unit: "",
    note: "run it free on your own server &middot; your data never leaves your network",
    cta: {
      label: "Get the source",
      href: "https://github.com/Vija02/TheOpenPresenter",
      primary: false,
    },
    features: [
      "The full app, on your hardware",
      "Your data stays on your network",
      "No limits beyond what your hardware allows",
      "AGPL 3.0, yours to read and modify",
      "You handle updates and backups",
    ],
  },
];

const faqs = [
  {
    q: "How many people can run a presentation at once?",
    a: "As many as you like, on every plan including Free. There are no seats and no per-user cost. This is the biggest difference from ProPresenter, which is licensed per seat, so a team of three users pays three times.",
  },
  {
    q: "Is the free plan really free?",
    a: "Yes, with no time limit and no card. It covers a small church running a weekly service. You'd move to Cloud if you run out of storage, want the AI lyric formatting, or need more than five connected displays.",
  },
  {
    q: "What if we're a small church and can't pay?",
    a: "Churches under 50 weekly attendance get the full Cloud plan free through our sponsorship programme, storage and AI credits included. It isn't a discount or a trial, it's the whole plan.",
  },
  {
    q: "What does the Lifetime licence actually get me?",
    a: "The Cloud plan, paid once, with no subscription afterwards. Bug fixes and security updates are always included. It suits organisations that would rather make a one-time purchase than carry a recurring cost, and it guarantees you'll never be affected by a future price change.",
  },
  {
    q: "Can I self-host instead?",
    a: "Yes. It's open source under AGPL 3.0, so you can run the whole thing on your own hardware for free, with no limits beyond what your server can handle. Your data never leaves your network. You handle updates, backups, and support yourself.",
  },
  {
    q: "Can I cancel?",
    a: "Any time, from your dashboard. There's no contract and no cancellation fee. Your content stays in your account, and you drop back to the Free plan rather than losing access.",
  },
  {
    q: "Do I need to buy hardware?",
    a: "No. It runs on any device with a modern browser. A Fire TV Stick, a Chromecast, an old laptop, or a mini PC all work. There's also a desktop app, TheOpenPresenter Studio, if you'd rather run it on the machine at the front.",
  },
  {
    q: "Can I move from monthly to Lifetime later?",
    a: "Yes. Email us and we'll credit what you've already paid on a monthly plan against the Lifetime licence.",
  },
];
---

<DefaultLayout
  title="Pricing | TheOpenPresenter"
  description="Free for small churches. £19 a month for unlimited users, with no per-seat subscription. Or self-host the open-source app on your own hardware."
>
  <!-- Page illustration -->
  <div
    class="relative max-w-6xl mx-auto h-0 pointer-events-none -z-1"
    aria-hidden="true"
  >
    <PageIllustration />
  </div>

  <section class="relative">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
      <div class="pt-32 pb-12 md:pt-40 md:pb-16">
        <!-- Page header -->
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="h1 font-red-hat-display mb-4" data-aos="fade-down">
            One price for your whole team
          </h1>
          <p
            class="text-xl text-gray-600 dark:text-gray-400"
            data-aos="fade-down"
            data-aos-delay="150"
          >
            No seats to count and no per-seat subscription. Start free and stay
            there as long as it works for you.
          </p>
        </div>

        <!-- Applies to every tier, so it's stated once rather than repeated
             in all three cards. -->
        <div
          class="max-w-6xl mx-auto mt-10 flex justify-center"
          data-aos="fade-up"
        >
          <p
            class="inline-flex items-center gap-2 rounded-full border border-teal-200 dark:border-teal-500/30 bg-teal-50 dark:bg-teal-500/10 px-4 py-2 text-sm font-medium text-teal-700 dark:text-teal-300"
          >
            <svg
              class="w-4 h-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M9 11a3 3 0 100-6 3 3 0 000 6z M3 20c0-3.3 2.7-5 6-5s6 1.7 6 5"
              ></path>
              <path d="M17 8a3 3 0 010 6 M17 15c2.5.4 4 2 4 5"></path>
            </svg>
            Every plan includes unlimited users
          </p>
        </div>

        <!-- Plans -->
        <div class="max-w-6xl mx-auto mt-6 grid gap-6 md:grid-cols-3">
          {
            plans.map((plan, i) => (
              <div
                class:list={[
                  "relative flex flex-col rounded-lg p-6 bg-white dark:bg-gray-900",
                  plan.highlight
                    ? "border-2 border-teal-500 shadow-lg"
                    : "border border-gray-200 dark:border-gray-800",
                ]}
                data-aos="fade-up"
                data-aos-delay={i * 150}
              >
                {plan.highlight && (
                  <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-teal-500 text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wide">
                    {plan.highlight}
                  </span>
                )}

                <div class="mb-6">
                  <h2 class="h3 font-red-hat-display mb-1">{plan.name}</h2>
                  <p class="text-sm text-gray-600 dark:text-gray-400">
                    {plan.blurb}
                  </p>
                </div>

                <div class="mb-1">
                  <span
                    class:list={[
                      "font-extrabold font-red-hat-display",
                      plan.unit ? "text-4xl" : "text-3xl",
                    ]}
                    set:html={plan.price}
                  />
                  {plan.unit && (
                    <span class="text-gray-600 dark:text-gray-400 ml-1">
                      {plan.unit}
                    </span>
                  )}
                </div>
                <p
                  class="text-sm text-gray-500 dark:text-gray-400 mb-6"
                  set:html={plan.note}
                />

                <a
                  class:list={[
                    "btn-sm w-full mb-6 justify-center",
                    plan.cta.primary
                      ? "text-white bg-teal-500 hover:bg-teal-400"
                      : "text-white bg-gray-700 hover:bg-gray-800 dark:bg-gray-700 dark:hover:bg-gray-600",
                  ]}
                  href={plan.cta.href}
                >
                  {plan.cta.label}
                </a>

                {plan.featuresHeading && (
                  <p class="text-xs uppercase tracking-wide font-semibold text-gray-500 dark:text-gray-400 mb-3">
                    {plan.featuresHeading}
                  </p>
                )}

                <ul class="text-sm text-gray-600 dark:text-gray-400 space-y-2">
                  {plan.features.map((feature) => (
                    <li class="flex items-start">
                      <svg
                        class="w-3 h-3 mt-1.5 mr-2 shrink-0 fill-current text-teal-500"
                        viewBox="0 0 12 12"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path d="M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z" />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <!-- Per-seat comparison -->
        <div
          class="max-w-4xl mx-auto mt-10 rounded-lg border border-gray-200 dark:border-gray-800 p-6"
          data-aos="fade-up"
        >
          <h2 class="font-red-hat-display font-black text-lg mb-2">
            Why we don't charge per seat
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            ProPresenter is licensed per seat, at $29 a month each. Most
            churches have more than one person who touches the slides: someone
            builds the service during the week, someone runs it on Sunday,
            someone fixes a typo from the back row. On a per-seat licence, each
            of them is another subscription.
          </p>
          <p class="text-gray-600 dark:text-gray-400">
            We charge for the organisation, not the person. One price, however
            many volunteers you have, on every plan including Free.
          </p>
        </div>

        <!-- Lifetime -->
        <div
          class="max-w-4xl mx-auto mt-6 rounded-lg border border-gray-200 dark:border-gray-800 p-6 md:flex md:items-center md:justify-between md:gap-8"
          data-aos="fade-up"
        >
          <div class="mb-4 md:mb-0">
            <h2 class="font-red-hat-display font-black text-lg mb-2">
              Would rather pay once?
            </h2>
            <p class="text-gray-600 dark:text-gray-400">
              The Lifetime licence is the Cloud plan bought once, with no
              subscription afterwards and no exposure to future price changes.
              Bug fixes and security updates are included for good. It's for
              organisations that would rather make a one-time purchase and forget about it.
            </p>
          </div>
          <div class="shrink-0 text-center">
            <div class="font-red-hat-display text-3xl font-extrabold">
              &pound;990
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">one-time</p>
            <a
              class="btn-sm text-teal-500 bg-white hover:bg-gray-50 border border-teal-500 dark:bg-transparent dark:hover:bg-gray-800 w-full justify-center"
              href="mailto:hello@theopenpresenter.com?subject=Lifetime%20licence"
            >
              Talk to us
            </a>
          </div>
        </div>

        <!-- Church sponsorship -->
        <div
          class="max-w-4xl mx-auto mt-6 rounded-lg border border-teal-200 dark:border-teal-500/30 bg-teal-50 dark:bg-teal-500/10 p-6"
          data-aos="fade-up"
        >
          <h2 class="font-red-hat-display font-black text-lg mb-2">
            Under 50 weekly attendance? It's free.
          </h2>
          <p class="text-gray-600 dark:text-gray-300">
            Small churches get the full Cloud plan at no cost through our
            sponsorship programme, storage and AI credits included. <a
              href="/church/sponsorship"
              class="text-teal-600 dark:text-teal-400 hover:underline font-medium"
              >See how it works</a
            >.
          </p>
        </div>

        <!-- Money-back guarantee -->
        <div
          class="max-w-4xl mx-auto mt-6 rounded-lg border border-gray-200 dark:border-gray-800 px-5 py-4 flex flex-col md:flex-row md:items-center gap-3 text-sm text-gray-600 dark:text-gray-400 text-center md:text-left"
          data-aos="fade-up"
        >
          <div
            class="flex items-center justify-center md:justify-start gap-2 shrink-0"
          >
            <svg
              class="w-5 h-5 text-teal-500 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M12 2.5l8 3v6.2c0 4.7-3.3 8.6-8 9.8-4.7-1.2-8-5.1-8-9.8V5.5l8-3z"
              ></path>
              <path d="M9 12.2l2.2 2.2L15.5 10"></path>
            </svg>
            <span class="font-medium text-gray-900 dark:text-gray-100"
              >30-day money-back guarantee</span
            >
          </div>
          <span class="flex-1">
            If a paid plan doesn't fit your church in the first 30 days, email
            us and we'll refund every penny.
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
      <div class="pb-12 md:pb-20">
        <div class="max-w-3xl mx-auto">
          <h2 class="h2 font-red-hat-display mb-8" data-aos="fade-up">
            Pricing FAQ
          </h2>
          <div class="flex flex-col gap-4">
            {
              faqs.map((faq) => (
                <details
                  class="rounded-lg border border-gray-200 dark:border-gray-800 p-5 group"
                  data-aos="fade-up"
                >
                  <summary class="cursor-pointer font-medium text-gray-900 dark:text-gray-100 flex items-center justify-between">
                    <span>{faq.q}</span>
                    <span
                      class="ml-4 text-gray-400 group-open:rotate-45 transition-transform"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </summary>
                  <p class="text-sm text-gray-600 dark:text-gray-400 mt-3">
                    {faq.a}
                  </p>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaSignup />
</DefaultLayout>
